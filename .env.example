# Flask session signing key. Use a long random string in production.
SECRET_KEY=change-me-to-a-random-string

# Password required to delete bosses, locations, branches, and statuses.
DELETE_PASSWORD=change-me

# Login credentials per role. A role only works if BOTH its login and
# password are set. Choose your own values.
READER_LOGIN=reader
READER_PASSWORD=change-me
EDITOR_LOGIN=editor
EDITOR_PASSWORD=change-me
ADMIN_LOGIN=admin
ADMIN_PASSWORD=change-me

# Location of the SQLite file. On Render, point this at the mounted disk.
# DATABASE_PATH=/var/data/abot.db
